{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puku.sh/protocols/hrp/v1.json",
  "title": "HRP · Harness Report Protocol v1",
  "description": "Fixed JSON protocol for distilling LLM turn execution into a structured report. Renderer consumes this; HTML author no longer writes markup.",
  "type": "object",
  "required": ["hrp", "report"],
  "additionalProperties": false,
  "properties": {
    "hrp": {
      "type": "string",
      "const": "1.0",
      "description": "Protocol version. Currently locked to \"1.0\"."
    },
    "report": {
      "type": "object",
      "required": ["title", "timestamp", "project", "status", "sections"],
      "additionalProperties": false,
      "properties": {
        "title":       { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle":    { "type": "string", "maxLength": 400 },
        "timestamp":   { "type": "string", "format": "date-time", "description": "ISO 8601" },
        "project":     { "type": "string", "minLength": 1 },
        "branch":      { "type": ["string", "null"] },
        "model":       { "type": "string" },
        "wall_time_seconds": { "type": "number", "minimum": 0 },
        "tokens": {
          "type": "object",
          "required": ["in", "out", "total"],
          "additionalProperties": false,
          "properties": {
            "in":    { "type": "integer", "minimum": 0 },
            "out":   { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "cost_usd":    { "type": "number", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["success", "partial", "failed", "noop"]
        },
        "sections": {
          "type": "object",
          "required": ["overview", "files", "decisions", "errors", "commands"],
          "additionalProperties": false,
          "properties": {
            "overview":  { "$ref": "#/$defs/OverviewSection" },
            "files":     { "type": "array", "items": { "$ref": "#/$defs/FileItem" } },
            "decisions": { "type": "array", "items": { "$ref": "#/$defs/DecisionItem" } },
            "errors":    { "type": "array", "items": { "$ref": "#/$defs/ErrorItem" } },
            "commands":  { "type": "array", "items": { "$ref": "#/$defs/CommandItem" } }
          }
        },
        "bullets_total": { "type": "integer", "minimum": 0, "description": "Computed by validator; renderer uses it for sidebar counts." }
      }
    }
  },
  "$defs": {
    "OverviewSection": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 40 },
              "value": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    },
    "FileItem": {
      "type": "object",
      "required": ["path", "action"],
      "additionalProperties": false,
      "properties": {
        "path":          { "type": "string", "minLength": 1 },
        "action":        { "type": "string", "enum": ["created", "modified", "deleted", "renamed"] },
        "summary":       { "type": "string", "maxLength": 300 },
        "lines_added":   { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 }
      }
    },
    "DecisionItem": {
      "type": "object",
      "required": ["title", "detail"],
      "additionalProperties": false,
      "properties": {
        "title":      { "type": "string", "minLength": 1, "maxLength": 80 },
        "detail":     { "type": "string", "minLength": 1, "maxLength": 600 },
        "tradeoffs":  { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "reversible": { "type": "boolean" }
      }
    },
    "ErrorItem": {
      "type": "object",
      "required": ["title", "severity"],
      "additionalProperties": false,
      "properties": {
        "title":          { "type": "string", "minLength": 1, "maxLength": 200 },
        "detail":         { "type": "string", "maxLength": 600 },
        "severity":       { "type": "string", "enum": ["error", "warn", "info"] },
        "source":         { "type": "string", "enum": ["command", "file", "tool", "other"] },
        "output_excerpt": { "type": "string", "maxLength": 1000 }
      }
    },
    "CommandItem": {
      "type": "object",
      "required": ["command", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "command":        { "type": "string", "minLength": 1, "maxLength": 500 },
        "exit_code":      { "type": "integer" },
        "duration_ms":    { "type": "integer", "minimum": 0 },
        "note":           { "type": "string", "maxLength": 300 },
        "output_excerpt": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
